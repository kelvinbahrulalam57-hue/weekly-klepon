rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all default
    match /{document=**} {
      allow read, write: if false;
    }

    // Participants: allow read, write, and delete for admin management
    match /participants/{participantId} {
      allow read: if true;
      allow create, update: if request.resource.data.phone is string && request.resource.data.name is string;
      allow delete: if true;
    }

    // Players / Leaderboard: public read, write allowed for point increments
    match /players/{playerId} {
      allow read: if true;
      allow write: if true;
    }

    // Win Reports (Storan Kemenangan): public read, create with valid phone and screenshot
    match /winReports/{reportId} {
      allow read: if true;
      allow create: if request.resource.data.phone is string && request.resource.data.screenshotUrl is string;
      allow update, delete: if true;
    }

    // Banners & Posters from Gallery: public read, write for new banners
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if true;
    }

    // Season Config: public read, write for resets
    match /season/{seasonId} {
      allow read: if true;
      allow write: if true;
    }

    // Blacklist: public read, write for admin bans
    match /blacklist/{blacklistId} {
      allow read: if true;
      allow write: if true;
    }

    // Contacts & Social Media: public read, write for admin configuration
    match /contacts/{contactId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
